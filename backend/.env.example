# Server secrets only. Never add these values to Xcode, Info.plist, or NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
APPLE_BUNDLE_ID=com.GregAdams.TimeBoxed
APPLE_APP_ID=6762071236
# App Store Connect > Users and Access > Integrations > In-App Purchase (App Store Server API key)
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Full .p8 contents, surrounded by double quotes; use literal \n between lines.
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=Production
# App ID prefix from Apple Developer > Identifiers (usually the Team ID).
APP_ATTEST_APP_ID_PREFIX=J3YZVWSX7K
APP_ATTEST_ENVIRONMENT=production
REDIS_URL=redis://localhost:6379
PLANNING_DAILY_LIMIT=30
PLANNING_GLOBAL_DAILY_LIMIT=10000
PORT=3000

# Mac mini tunnel container file ownership; use id -u / id -g for your Mac user.
HOST_UID=501
HOST_GID=20
