APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=Production
REDIS_URL=redis://localhost:6379
PLANNING_DAILY_LIMIT=30
PLANNING_GLOBAL_DAILY_LIMIT=10000
PORT=3000
